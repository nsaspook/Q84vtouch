 63896                           
 63897                           ;Config register CONFIG2 @ 0x300001
 63898                           ;	Clock out Enable bit
 63899                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 63900                           ;	PRLOCKED One-Way Set Enable bit
 63901                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 63902                           ;	Clock Switch Enable bit
