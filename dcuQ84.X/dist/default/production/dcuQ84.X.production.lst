 35664                           ;Config register CONFIG1 @ 0x300000
 35665                           ;	External Oscillator Selection
 35666                           ;	FEXTOSC = ECH, EC (external clock) above 8 MHz
 35667                           ;	Reset Oscillator Selection
 35668                           ;	RSTOSC = EXTOSC_4PLL, EXTOSC with 4x PLL, with EXTOSC operating per FEXTOSC bits
 35669   300000                     	org	3145728
 35670   300000  AF                 	db	175
 35671                           
 35672                           ;Config register CONFIG2 @ 0x300001
 35673                           ;	Clock out Enable bit
 35674                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 35675                           ;	PRLOCKED One-Way Set Enable bit
 35676                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 35677                           ;	Clock Switch Enable bit
 35678                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 35679                           ;	JTAG Enable bit
 35680                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 35681                           ;	Fail-Safe Clock Monitor Enable bit
 35682                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 35683                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 35684                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 35685                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 35686                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 35687   300001                     	org	3145729
 35688   300001  EC                 	db	236
 35689                           
 35690                           ;Config register CONFIG3 @ 0x300002
 35691                           ;	MCLR Enable bit
 35692                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 35693                           ;	Power-up timer selection bits
 35694                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 35695                           ;	Multi-vector enable bit
