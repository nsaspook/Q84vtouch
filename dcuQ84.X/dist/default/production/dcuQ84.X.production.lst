 63849                           ;Config register CONFIG1 @ 0x300000
 63850                           ;	External Oscillator Selection
 63851                           ;	FEXTOSC = ECH, EC (external clock) above 8 MHz
 63852                           ;	Reset Oscillator Selection
 63853                           ;	RSTOSC = EXTOSC_4PLL, EXTOSC with 4x PLL, with EXTOSC operating per FEXTOSC bits
 63854   300000                     	org	3145728
 63855   300000  AF                 	db	175
 63856                           
 63857                           ;Config register CONFIG2 @ 0x300001
 63858                           ;	Clock out Enable bit
 63859                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 63860                           ;	PRLOCKED One-Way Set Enable bit
 63861                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 63862                           ;	Clock Switch Enable bit
 63863                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 63864                           ;	JTAG Enable bit
 63865                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 63866                           ;	Fail-Safe Clock Monitor Enable bit
 63867                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 63868                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 63869                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 63870                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 63871                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 63872   300001                     	org	3145729
 63873   300001  EC                 	db	236
 63874                           
 63875                           ;Config register CONFIG3 @ 0x300002
 63876                           ;	MCLR Enable bit
 63877                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 63878                           ;	Power-up timer selection bits
 63879                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 63880                           ;	Multi-vector enable bit
 63881                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 63882                           ;	IVTLOCK bit One-way set enable bit
 63883                           ;	IVT1WAY = ON, IVTLOCKED bit can be cleared and set only once
 63884                           ;	Low Power BOR Enable bit
 63885                           ;	LPBOREN = OFF, Low-Power BOR disabled
 63886                           ;	Brown-out Reset Enable bits
 63887                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
 63888   300002                     	org	3145730
 63889   300002  FF                 	db	255
