 65379                           ;Config register CONFIG1 @ 0x300000
 65380                           ;	External Oscillator Selection
 65381                           ;	FEXTOSC = ECH, EC (external clock) above 8 MHz
 65382                           ;	Reset Oscillator Selection
 65383                           ;	RSTOSC = EXTOSC_4PLL, EXTOSC with 4x PLL, with EXTOSC operating per FEXTOSC bits
 65384   300000                     	org	3145728
 65385   300000  AF                 	db	175
 65386                           
 65387                           ;Config register CONFIG2 @ 0x300001
 65388                           ;	Clock out Enable bit
 65389                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 65390                           ;	PRLOCKED One-Way Set Enable bit
 65391                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 65392                           ;	Clock Switch Enable bit
 65393                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 65394                           ;	JTAG Enable bit
 65395                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 65396                           ;	Fail-Safe Clock Monitor Enable bit
 65397                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 65398                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 65399                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 65400                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 65401                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 65402   300001                     	org	3145729
 65403   300001  EC                 	db	236
 65404                           
 65405                           ;Config register CONFIG3 @ 0x300002
 65406                           ;	MCLR Enable bit
 65407                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 65408                           ;	Power-up timer selection bits
 65409                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 65410                           ;	Multi-vector enable bit
 65411                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 65412                           ;	IVTLOCK bit One-way set enable bit
 65413                           ;	IVT1WAY = ON, IVTLOCKED bit can be cleared and set only once
 65414                           ;	Low Power BOR Enable bit
 65415                           ;	LPBOREN = OFF, Low-Power BOR disabled
 65416                           ;	Brown-out Reset Enable bits
 65417                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
 65418   300002                     	org	3145730
 65419   300002  FF                 	db	255
 65420                           
 65421                           ;Config register CONFIG4 @ 0x300003
 65422                           ;	Brown-out Reset Voltage Selection bits
