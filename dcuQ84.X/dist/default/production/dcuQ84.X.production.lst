 63366                           
 63367                           ;Config register CONFIG2 @ 0x300001
 63368                           ;	Clock out Enable bit
 63369                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 63370                           ;	PRLOCKED One-Way Set Enable bit
 63371                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 63372                           ;	Clock Switch Enable bit
 63373                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 63374                           ;	JTAG Enable bit
 63375                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 63376                           ;	Fail-Safe Clock Monitor Enable bit
 63377                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 63378                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 63379                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 63380                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 63381                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
