 36556                           
 36557                           ;Config register CONFIG2 @ 0x300001
 36558                           ;	Clock out Enable bit
 36559                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 36560                           ;	PRLOCKED One-Way Set Enable bit
 36561                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 36562                           ;	Clock Switch Enable bit
 36563                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 36564                           ;	JTAG Enable bit
 36565                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 36566                           ;	Fail-Safe Clock Monitor Enable bit
 36567                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 36568                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 36569                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 36570                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 36571                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 36572   300001                     	org	3145729
 36573   300001  EC                 	db	236
