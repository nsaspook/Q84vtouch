 43577                           ;Config register CONFIG3 @ 0x300002
 43578                           ;	MCLR Enable bit
 43579                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 43580                           ;	Power-up timer selection bits
 43581                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 43582                           ;	Multi-vector enable bit
 43583                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 43584                           ;	IVTLOCK bit One-way set enable bit
 43585                           ;	IVT1WAY = ON, IVTLOCKED bit can be cleared and set only once
 43586                           ;	Low Power BOR Enable bit
 43587                           ;	LPBOREN = OFF, Low-Power BOR disabled
 43588                           ;	Brown-out Reset Enable bits
 43589                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
