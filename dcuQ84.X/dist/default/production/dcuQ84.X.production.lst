 36556   300000                     	org	3145728
 36557   300000  AF                 	db	175
 36558                           
 36559                           ;Config register CONFIG2 @ 0x300001
 36560                           ;	Clock out Enable bit
 36561                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 36562                           ;	PRLOCKED One-Way Set Enable bit
 36563                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 36564                           ;	Clock Switch Enable bit
 36565                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 36566                           ;	JTAG Enable bit
 36567                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 36568                           ;	Fail-Safe Clock Monitor Enable bit
 36569                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 36570                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 36571                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 36572                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 36573                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 36574   300001                     	org	3145729
 36575   300001  EC                 	db	236
