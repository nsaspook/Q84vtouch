 41613                           ;Config register CONFIG1 @ 0x300000
 41614                           ;	External Oscillator Selection
 41615                           ;	FEXTOSC = ECH, EC (external clock) above 8 MHz
 41616                           ;	Reset Oscillator Selection
 41617                           ;	RSTOSC = EXTOSC_4PLL, EXTOSC with 4x PLL, with EXTOSC operating per FEXTOSC bits
 41618   300000                     	org	3145728
 41619   300000  AF                 	db	175
 41620                           
 41621                           ;Config register CONFIG2 @ 0x300001
 41622                           ;	Clock out Enable bit
 41623                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 41624                           ;	PRLOCKED One-Way Set Enable bit
 41625                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 41626                           ;	Clock Switch Enable bit
 41627                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 41628                           ;	JTAG Enable bit
 41629                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 41630                           ;	Fail-Safe Clock Monitor Enable bit
 41631                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 41632                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 41633                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 41634                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 41635                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 41636   300001                     	org	3145729
 41637   300001  EC                 	db	236
 41638                           
 41639                           ;Config register CONFIG3 @ 0x300002
 41640                           ;	MCLR Enable bit
 41641                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 41642                           ;	Power-up timer selection bits
 41643                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 41644                           ;	Multi-vector enable bit
 41645                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 41646                           ;	IVTLOCK bit One-way set enable bit
 41647                           ;	IVT1WAY = ON, IVTLOCKED bit can be cleared and set only once
 41648                           ;	Low Power BOR Enable bit
 41649                           ;	LPBOREN = OFF, Low-Power BOR disabled
 41650                           ;	Brown-out Reset Enable bits
 41651                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
 41652   300002                     	org	3145730
 41653   300002  FF                 	db	255
 41654                           
 41655                           ;Config register CONFIG4 @ 0x300003
 41656                           ;	Brown-out Reset Voltage Selection bits
