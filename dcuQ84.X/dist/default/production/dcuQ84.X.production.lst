 36010                           ;Config register CONFIG1 @ 0x300000
 36011                           ;	External Oscillator Selection
 36012                           ;	FEXTOSC = ECH, EC (external clock) above 8 MHz
 36013                           ;	Reset Oscillator Selection
 36014                           ;	RSTOSC = EXTOSC_4PLL, EXTOSC with 4x PLL, with EXTOSC operating per FEXTOSC bits
 36015   300000                     	org	3145728
 36016   300000  AF                 	db	175
 36017                           
 36018                           ;Config register CONFIG2 @ 0x300001
 36019                           ;	Clock out Enable bit
 36020                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 36021                           ;	PRLOCKED One-Way Set Enable bit
 36022                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 36023                           ;	Clock Switch Enable bit
 36024                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 36025                           ;	JTAG Enable bit
 36026                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 36027                           ;	Fail-Safe Clock Monitor Enable bit
 36028                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 36029                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 36030                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 36031                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 36032                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 36033   300001                     	org	3145729
 36034   300001  EC                 	db	236
 36035                           
 36036                           ;Config register CONFIG3 @ 0x300002
 36037                           ;	MCLR Enable bit
 36038                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 36039                           ;	Power-up timer selection bits
 36040                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 36041                           ;	Multi-vector enable bit
 36042                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 36043                           ;	IVTLOCK bit One-way set enable bit
 36044                           ;	IVT1WAY = ON, IVTLOCKED bit can be cleared and set only once
 36045                           ;	Low Power BOR Enable bit
 36046                           ;	LPBOREN = OFF, Low-Power BOR disabled
 36047                           ;	Brown-out Reset Enable bits
 36048                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
 36049   300002                     	org	3145730
 36050   300002  FF                 	db	255
 36051                           
