 42290                           ;Config register CONFIG1 @ 0x300000
 42291                           ;	External Oscillator Selection
 42292                           ;	FEXTOSC = ECH, EC (external clock) above 8 MHz
 42293                           ;	Reset Oscillator Selection
 42294                           ;	RSTOSC = EXTOSC_4PLL, EXTOSC with 4x PLL, with EXTOSC operating per FEXTOSC bits
 42295   300000                     	org	3145728
 42296   300000  AF                 	db	175
 42297                           
 42298                           ;Config register CONFIG2 @ 0x300001
 42299                           ;	Clock out Enable bit
 42300                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 42301                           ;	PRLOCKED One-Way Set Enable bit
 42302                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 42303                           ;	Clock Switch Enable bit
 42304                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 42305                           ;	JTAG Enable bit
 42306                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 42307                           ;	Fail-Safe Clock Monitor Enable bit
 42308                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 42309                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 42310                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 42311                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 42312                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 42313   300001                     	org	3145729
 42314   300001  EC                 	db	236
 42315                           
 42316                           ;Config register CONFIG3 @ 0x300002
 42317                           ;	MCLR Enable bit
 42318                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 42319                           ;	Power-up timer selection bits
 42320                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 42321                           ;	Multi-vector enable bit
 42322                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 42323                           ;	IVTLOCK bit One-way set enable bit
 42324                           ;	IVT1WAY = ON, IVTLOCKED bit can be cleared and set only once
 42325                           ;	Low Power BOR Enable bit
 42326                           ;	LPBOREN = OFF, Low-Power BOR disabled
 42327                           ;	Brown-out Reset Enable bits
 42328                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
 42329   300002                     	org	3145730
 42330   300002  FF                 	db	255
 42331                           
 42332                           ;Config register CONFIG4 @ 0x300003
