 65411                           ;Config register CONFIG1 @ 0x300000
 65412                           ;	External Oscillator Selection
 65413                           ;	FEXTOSC = ECH, EC (external clock) above 8 MHz
 65414                           ;	Reset Oscillator Selection
 65415                           ;	RSTOSC = EXTOSC_4PLL, EXTOSC with 4x PLL, with EXTOSC operating per FEXTOSC bits
 65416   300000                     	org	3145728
 65417   300000  AF                 	db	175
 65418                           
 65419                           ;Config register CONFIG2 @ 0x300001
 65420                           ;	Clock out Enable bit
 65421                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 65422                           ;	PRLOCKED One-Way Set Enable bit
 65423                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 65424                           ;	Clock Switch Enable bit
 65425                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 65426                           ;	JTAG Enable bit
 65427                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 65428                           ;	Fail-Safe Clock Monitor Enable bit
 65429                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 65430                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 65431                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 65432                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 65433                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 65434   300001                     	org	3145729
 65435   300001  EC                 	db	236
 65436                           
 65437                           ;Config register CONFIG3 @ 0x300002
 65438                           ;	MCLR Enable bit
 65439                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 65440                           ;	Power-up timer selection bits
 65441                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 65442                           ;	Multi-vector enable bit
 65443                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 65444                           ;	IVTLOCK bit One-way set enable bit
