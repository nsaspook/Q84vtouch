 36650                           ;Config register CONFIG1 @ 0x300000
 36651                           ;	External Oscillator Selection
 36652                           ;	FEXTOSC = ECH, EC (external clock) above 8 MHz
 36653                           ;	Reset Oscillator Selection
 36654                           ;	RSTOSC = EXTOSC_4PLL, EXTOSC with 4x PLL, with EXTOSC operating per FEXTOSC bits
 36655   300000                     	org	3145728
 36656   300000  AF                 	db	175
 36657                           
 36658                           ;Config register CONFIG2 @ 0x300001
 36659                           ;	Clock out Enable bit
 36660                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 36661                           ;	PRLOCKED One-Way Set Enable bit
 36662                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 36663                           ;	Clock Switch Enable bit
 36664                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 36665                           ;	JTAG Enable bit
 36666                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 36667                           ;	Fail-Safe Clock Monitor Enable bit
 36668                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 36669                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 36670                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 36671                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 36672                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 36673   300001                     	org	3145729
 36674   300001  EC                 	db	236
 36675                           
 36676                           ;Config register CONFIG3 @ 0x300002
 36677                           ;	MCLR Enable bit
 36678                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 36679                           ;	Power-up timer selection bits
 36680                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 36681                           ;	Multi-vector enable bit
 36682                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 36683                           ;	IVTLOCK bit One-way set enable bit
 36684                           ;	IVT1WAY = ON, IVTLOCKED bit can be cleared and set only once
 36685                           ;	Low Power BOR Enable bit
 36686                           ;	LPBOREN = OFF, Low-Power BOR disabled
 36687                           ;	Brown-out Reset Enable bits
 36688                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
 36689   300002                     	org	3145730
 36690   300002  FF                 	db	255
