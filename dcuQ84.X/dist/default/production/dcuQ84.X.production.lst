 36626   300000                     	org	3145728
 36627   300000  AF                 	db	175
 36628                           
 36629                           ;Config register CONFIG2 @ 0x300001
 36630                           ;	Clock out Enable bit
 36631                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 36632                           ;	PRLOCKED One-Way Set Enable bit
 36633                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 36634                           ;	Clock Switch Enable bit
 36635                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 36636                           ;	JTAG Enable bit
 36637                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 36638                           ;	Fail-Safe Clock Monitor Enable bit
 36639                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 36640                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 36641                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 36642                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 36643                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 36644   300001                     	org	3145729
 36645   300001  EC                 	db	236
 36646                           
 36647                           ;Config register CONFIG3 @ 0x300002
 36648                           ;	MCLR Enable bit
 36649                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 36650                           ;	Power-up timer selection bits
 36651                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 36652                           ;	Multi-vector enable bit
 36653                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 36654                           ;	IVTLOCK bit One-way set enable bit
 36655                           ;	IVT1WAY = ON, IVTLOCKED bit can be cleared and set only once
 36656                           ;	Low Power BOR Enable bit
 36657                           ;	LPBOREN = OFF, Low-Power BOR disabled
 36658                           ;	Brown-out Reset Enable bits
 36659                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
