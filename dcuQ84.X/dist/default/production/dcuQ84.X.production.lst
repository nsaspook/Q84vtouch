 60468                           ;Config register CONFIG1 @ 0x300000
 60469                           ;	External Oscillator Selection
 60470                           ;	FEXTOSC = ECH, EC (external clock) above 8 MHz
 60471                           ;	Reset Oscillator Selection
 60472                           ;	RSTOSC = EXTOSC_4PLL, EXTOSC with 4x PLL, with EXTOSC operating per FEXTOSC bits
 60473   300000                     	org	3145728
 60474   300000  AF                 	db	175
 60475                           
 60476                           ;Config register CONFIG2 @ 0x300001
 60477                           ;	Clock out Enable bit
 60478                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 60479                           ;	PRLOCKED One-Way Set Enable bit
 60480                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 60481                           ;	Clock Switch Enable bit
 60482                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 60483                           ;	JTAG Enable bit
 60484                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 60485                           ;	Fail-Safe Clock Monitor Enable bit
 60486                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 60487                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 60488                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 60489                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 60490                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 60491   300001                     	org	3145729
 60492   300001  EC                 	db	236
 60493                           
 60494                           ;Config register CONFIG3 @ 0x300002
 60495                           ;	MCLR Enable bit
 60496                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 60497                           ;	Power-up timer selection bits
 60498                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 60499                           ;	Multi-vector enable bit
 60500                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 60501                           ;	IVTLOCK bit One-way set enable bit
 60502                           ;	IVT1WAY = ON, IVTLOCKED bit can be cleared and set only once
 60503                           ;	Low Power BOR Enable bit
 60504                           ;	LPBOREN = OFF, Low-Power BOR disabled
 60505                           ;	Brown-out Reset Enable bits
 60506                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
 60507   300002                     	org	3145730
 60508   300002  FF                 	db	255
 60509                           
 60510                           ;Config register CONFIG4 @ 0x300003
 60511                           ;	Brown-out Reset Voltage Selection bits
 60512                           ;	BORV = VBOR_1P9, Brown-out Reset Voltage (VBOR) set to 1.9V
 60513                           ;	ZCD Disable bit
 60514                           ;	ZCD = OFF, ZCD module is disabled. ZCD can be enabled by setting the ZCDSEN bit of ZCD
      +                          CON
 60515                           ;	PPSLOCK bit One-Way Set Enable bit
 60516                           ;	PPS1WAY = OFF, PPSLOCKED bit can be set and cleared repeatedly (subject to the unlock 
      +                          sequence)
 60517                           ;	Stack Full/Underflow Reset Enable bit
 60518                           ;	STVREN = ON, Stack full/underflow will cause Reset
 60519                           ;	Low Voltage Programming Enable bit
 60520                           ;	LVP = OFF, HV on MCLR/VPP must be used for programming
 60521                           ;	Extended Instruction Set Enable bit
 60522                           ;	XINST = OFF, Extended Instruction Set and Indexed Addressing Mode disabled
 60523   300003                     	org	3145731
 60524   300003  D7                 	db	215
 60525                           
