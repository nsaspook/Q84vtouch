 60509                           
 60510                           ;Config register CONFIG1 @ 0x300000
 60511                           ;	External Oscillator Selection
 60512                           ;	FEXTOSC = ECH, EC (external clock) above 8 MHz
 60513                           ;	Reset Oscillator Selection
 60514                           ;	RSTOSC = EXTOSC_4PLL, EXTOSC with 4x PLL, with EXTOSC operating per FEXTOSC bits
 60515   300000                     	org	3145728
 60516   300000  AF                 	db	175
 60517                           
 60518                           ;Config register CONFIG2 @ 0x300001
 60519                           ;	Clock out Enable bit
 60520                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 60521                           ;	PRLOCKED One-Way Set Enable bit
 60522                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 60523                           ;	Clock Switch Enable bit
 60524                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 60525                           ;	JTAG Enable bit
 60526                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 60527                           ;	Fail-Safe Clock Monitor Enable bit
 60528                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 60529                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 60530                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 60531                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 60532                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 60533   300001                     	org	3145729
 60534   300001  EC                 	db	236
 60535                           
 60536                           ;Config register CONFIG3 @ 0x300002
 60537                           ;	MCLR Enable bit
 60538                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 60539                           ;	Power-up timer selection bits
 60540                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 60541                           ;	Multi-vector enable bit
 60542                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 60543                           ;	IVTLOCK bit One-way set enable bit
 60544                           ;	IVT1WAY = ON, IVTLOCKED bit can be cleared and set only once
 60545                           ;	Low Power BOR Enable bit
 60546                           ;	LPBOREN = OFF, Low-Power BOR disabled
 60547                           ;	Brown-out Reset Enable bits
 60548                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
 60549   300002                     	org	3145730
 60550   300002  FF                 	db	255
 60551                           
 60552                           ;Config register CONFIG4 @ 0x300003
 60553                           ;	Brown-out Reset Voltage Selection bits
 60554                           ;	BORV = VBOR_1P9, Brown-out Reset Voltage (VBOR) set to 1.9V
 60555                           ;	ZCD Disable bit
 60556                           ;	ZCD = OFF, ZCD module is disabled. ZCD can be enabled by setting the ZCDSEN bit of ZCD
      +                          CON
 60557                           ;	PPSLOCK bit One-Way Set Enable bit
 60558                           ;	PPS1WAY = OFF, PPSLOCKED bit can be set and cleared repeatedly (subject to the unlock 
      +                          sequence)
 60559                           ;	Stack Full/Underflow Reset Enable bit
 60560                           ;	STVREN = ON, Stack full/underflow will cause Reset
 60561                           ;	Low Voltage Programming Enable bit
 60562                           ;	LVP = OFF, HV on MCLR/VPP must be used for programming
 60563                           ;	Extended Instruction Set Enable bit
 60564                           ;	XINST = OFF, Extended Instruction Set and Indexed Addressing Mode disabled
 60565   300003                     	org	3145731
 60566   300003  D7                 	db	215
 60567                           
