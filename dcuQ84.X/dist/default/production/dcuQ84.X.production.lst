 43556   300000                     	org	3145728
 43557   300000  AF                 	db	175
 43558                           
 43559                           ;Config register CONFIG2 @ 0x300001
 43560                           ;	Clock out Enable bit
 43561                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 43562                           ;	PRLOCKED One-Way Set Enable bit
 43563                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 43564                           ;	Clock Switch Enable bit
 43565                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 43566                           ;	JTAG Enable bit
 43567                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 43568                           ;	Fail-Safe Clock Monitor Enable bit
 43569                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 43570                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 43571                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 43572                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 43573                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 43574   300001                     	org	3145729
 43575   300001  EC                 	db	236
