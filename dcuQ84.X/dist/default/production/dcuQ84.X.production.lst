 63641                           ;Config register CONFIG1 @ 0x300000
 63642                           ;	External Oscillator Selection
 63643                           ;	FEXTOSC = ECH, EC (external clock) above 8 MHz
 63644                           ;	Reset Oscillator Selection
 63645                           ;	RSTOSC = EXTOSC_4PLL, EXTOSC with 4x PLL, with EXTOSC operating per FEXTOSC bits
 63646   300000                     	org	3145728
 63647   300000  AF                 	db	175
 63648                           
 63649                           ;Config register CONFIG2 @ 0x300001
 63650                           ;	Clock out Enable bit
 63651                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 63652                           ;	PRLOCKED One-Way Set Enable bit
 63653                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 63654                           ;	Clock Switch Enable bit
 63655                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 63656                           ;	JTAG Enable bit
 63657                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 63658                           ;	Fail-Safe Clock Monitor Enable bit
 63659                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 63660                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 63661                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 63662                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 63663                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 63664   300001                     	org	3145729
 63665   300001  EC                 	db	236
 63666                           
 63667                           ;Config register CONFIG3 @ 0x300002
 63668                           ;	MCLR Enable bit
 63669                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 63670                           ;	Power-up timer selection bits
 63671                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 63672                           ;	Multi-vector enable bit
 63673                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 63674                           ;	IVTLOCK bit One-way set enable bit
 63675                           ;	IVT1WAY = ON, IVTLOCKED bit can be cleared and set only once
 63676                           ;	Low Power BOR Enable bit
 63677                           ;	LPBOREN = OFF, Low-Power BOR disabled
 63678                           ;	Brown-out Reset Enable bits
 63679                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
 63680   300002                     	org	3145730
 63681   300002  FF                 	db	255
 63682                           
 63683                           ;Config register CONFIG4 @ 0x300003
 63684                           ;	Brown-out Reset Voltage Selection bits
